          "title": "p95 latency",
          "description": "95% of the selected service's requests finished faster than this over the last 5 minutes. Percentiles instead of average, because the average hides the slow tail that users actually feel. Thresholds (500 ms / 1 s) are a starting point; tune them per service.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
