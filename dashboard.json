    "cursorSync": "Crosshair",
    "description": "RED (Rate, Errors, Duration) overview for a single service in the OpenTelemetry Demo, built on span metrics. Pick a service in the dropdown. Read top to bottom: Overview answers 'is it healthy?', Trends show when it changed, Breakdown shows which operation is responsible, Resources (USE) help find the cause.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Request rate",
          "description": "Requests per second handled by the selected service, averaged over the last 5 minutes. Gives context for the error % (5% of 2 req/s is very different from 5% of 2000 req/s). A sudden drop to zero can mean the service is unreachable, not idle.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "webstore-metrics"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"$service\"}[5m]))",
                        "legendFormat": "req/s",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps",
                  "decimals": 2,
                  "color": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Error rate",
          "description": "Percentage of the selected service's requests (spans) that ended with an error status over the last 5 minutes. Green < 1%, yellow 1-5%, red > 5% (same threshold as the 'High error rate' alert). If red: check Trends for when it started, then Breakdown for which operation.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "webstore-metrics"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(rate(traces_span_metrics_calls_total{service_name=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0))\n/\nsum(rate(traces_span_metrics_calls_total{service_name=\"$service\"}[5m])) * 100",
                        "legendFormat": "error %",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.1",
